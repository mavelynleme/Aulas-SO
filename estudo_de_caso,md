---

### 📌 Diagrama UML – Arquitetura em Nuvem

```plantuml id="h2n8q4"
@startuml

cloud "Nuvem" {

  node "Load Balancer" {
  }

  node "Servidor 1" {
    component "Container"
  }

  node "Servidor 2" {
    component "Container"
  }

  database "Storage"

}

"Load Balancer" --> "Servidor 1"
"Load Balancer" --> "Servidor 2"
"Servidor 1" --> "Storage"
"Servidor 2" --> "Storage"

@enduml
```

